{
  "name": "todo-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "storage:export": "node server/storage-export.ts",
    "dev": "node --watch --env-file-if-exists=.env server/index.ts",
    "build": "esbuild chat=src/main.tsx initial-theme=src/initial-theme.ts --bundle --minify --outdir=dist && npm run build:speech && tailwindcss -i src/theme.css -o dist/theme.css --minify",
    "build:speech": "esbuild src/speech/recognize.ts src/speech/download.ts --bundle --format=esm --minify --outdir=dist/speech && cp node_modules/onnxruntime-web/dist/ort-wasm-simd-threaded.asyncify.* dist/speech/",
    "start": "node --env-file-if-exists=.env server/index.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.browser.json",
    "test": "node --test server/*.test.ts",
    "fmt": "oxfmt --write .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "predev": "npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "1.6.0",
    "@earendil-works/pi-ai": "1.6.0",
    "@heroui/react": "3.2.8",
    "@heroui/styles": "3.2.8",
    "@huggingface/transformers": "4.3.2",
    "@internationalized/date": "3.12.4",
    "express": "^5.3.0",
    "motion": "14.14.0",
    "openai": "^7.64.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "4.3.5",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.1",
    "@types/react-dom": "^19.3.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.80.0",
    "oxlint": "^1.95.0",
    "tailwindcss": "4.3.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.12.0"
  }
}
